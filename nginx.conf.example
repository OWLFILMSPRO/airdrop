# Nginx Configuration Example
# OWL AirDrop — owlfilms.pro/airdrop
#
# This file shows how to proxy the Node.js signaling server
# (running on port 3000) behind Nginx with SSL termination.
#
# Copy the relevant server block into your Nginx config and
# reload: nginx -s reload

# ─── Upstream (Node.js) ───────────────────────────────────────
upstream owl_airdrop {
    server 127.0.0.1:3000;
    keepalive 32;
}

# ─── HTTP → HTTPS redirect ────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name owlfilms.pro www.owlfilms.pro;

    location / {
        return 301 https://$host$request_uri;
    }
}

# ─── HTTPS server ────────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name owlfilms.pro www.owlfilms.pro;

    # SSL — adjust paths to your certificate files
    ssl_certificate     /etc/letsencrypt/live/owlfilms.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/owlfilms.pro/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options            DENY                                  always;
    add_header X-Content-Type-Options     nosniff                               always;
    add_header Referrer-Policy            strict-origin-when-cross-origin       always;

    # ── WebSocket signaling endpoint ──────────────────────────
    # Must come BEFORE the general /airdrop block
    location /airdrop-ws {
        proxy_pass          http://owl_airdrop;
        proxy_http_version  1.1;

        # WebSocket upgrade headers
        proxy_set_header    Upgrade    $http_upgrade;
        proxy_set_header    Connection "Upgrade";

        # Forward real client IP (used for subnet grouping)
        proxy_set_header    X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header    X-Real-IP        $remote_addr;
        proxy_set_header    Host             $host;

        # Keep connections alive for a long time
        proxy_read_timeout  86400s;
        proxy_send_timeout  86400s;
    }

    # ── Static SPA + API ─────────────────────────────────────
    location /airdrop {
        proxy_pass          http://owl_airdrop;
        proxy_http_version  1.1;

        proxy_set_header    Host             $host;
        proxy_set_header    X-Real-IP        $remote_addr;
        proxy_set_header    X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto https;

        # Cache static assets aggressively
        location ~* \.(css|js|ico|png|svg|woff2?)$ {
            proxy_pass http://owl_airdrop;
            proxy_cache_valid 200 1d;
            add_header Cache-Control "public, max-age=86400";
        }
    }

    # ── Everything else (your main site) ──────────────────────
    # location / {
    #     root /var/www/owlfilms;
    #     index index.html;
    # }
}
